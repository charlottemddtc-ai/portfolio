{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "/", "dest": "/api/index.php?page=index" },
    { "src": "/(index|about|projects|contact)(\\.php)?", "dest": "/api/index.php?page=$1" },
    { "src": "/(fonctions\\.php|composants/.*|api/.*|vercel\\.json|README\\.md)", "status": 404, "dest": "/api/index.php?page=404" },
    { "handle": "filesystem" },
    { "src": "/.*", "status": 404, "dest": "/api/index.php?page=404" }
  ]
}
